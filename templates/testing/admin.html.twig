<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GEFORP API - Admin Testing Interface</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1e3a5f 0%, #2c5f8a 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container { max-width: 1300px; margin: 0 auto; }

        h1 {
            color: white;
            text-align: center;
            margin-bottom: 10px;
            font-size: 2.2em;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .subtitle {
            color: rgba(255,255,255,0.8);
            text-align: center;
            margin-bottom: 25px;
            font-size: 0.95em;
        }

        .session-bar {
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.3);
            border-radius: 8px;
            padding: 12px 20px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            color: white;
            font-size: 0.85em;
        }

        .session-bar .badge {
            background: #28a745;
            padding: 4px 10px;
            border-radius: 12px;
            font-weight: 600;
        }

        .session-bar .badge.off { background: #6c757d; }

        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        @media (max-width: 900px) {
            .grid { grid-template-columns: 1fr; }
        }

        .card {
            background: white;
            border-radius: 8px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .card h2 {
            color: #2c5f8a;
            margin-bottom: 20px;
            font-size: 1.3em;
            border-bottom: 2px solid #2c5f8a;
            padding-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card h2 .method-badge {
            font-size: 0.6em;
            padding: 3px 8px;
            border-radius: 4px;
            font-weight: 700;
            color: white;
        }
        .method-badge.get { background: #28a745; }
        .method-badge.post { background: #007bff; }

        .form-group { margin-bottom: 14px; }

        label {
            display: block;
            margin-bottom: 5px;
            color: #333;
            font-weight: 600;
            font-size: 0.85em;
        }

        input[type="text"], input[type="password"], input[type="email"], textarea, select {
            width: 100%;
            padding: 11px;
            border: 2px solid #ddd;
            border-radius: 4px;
            font-family: 'Courier New', monospace;
            font-size: 0.88em;
            transition: border-color 0.3s;
        }

        input:focus, textarea:focus, select:focus {
            outline: none;
            border-color: #2c5f8a;
        }

        button {
            background: #2c5f8a;
            color: white;
            padding: 11px 22px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.92em;
            transition: background 0.3s;
            width: 100%;
            margin-top: 8px;
        }

        button:hover { background: #1e3a5f; }
        button.secondary { background: #6c757d; margin-top: 5px; }
        button.secondary:hover { background: #545b62; }
        button.danger { background: #dc3545; }
        button.danger:hover { background: #a71d2a; }

        .quick-buttons {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-bottom: 12px;
        }
        .quick-buttons button { margin-top: 0; padding: 8px; font-size: 0.8em; }

        .response-box {
            background: #f8f9fa;
            border: 2px solid #ddd;
            border-radius: 4px;
            padding: 14px;
            margin-top: 14px;
            font-family: 'Courier New', monospace;
            font-size: 0.8em;
            max-height: 280px;
            overflow-y: auto;
            word-break: break-all;
            white-space: pre-wrap;
        }

        .response-box.success { border-color: #28a745; background: #d4edda; color: #155724; }
        .response-box.error { border-color: #dc3545; background: #f8d7da; color: #721c24; }

        .info-box {
            background: #e7f3ff;
            border-left: 4px solid #2196F3;
            padding: 12px;
            margin-bottom: 14px;
            border-radius: 4px;
            font-size: 0.85em;
            color: #0c3d7a;
        }

        .warn-box {
            background: #fff3cd;
            border-left: 4px solid #ffc107;
            padding: 12px;
            margin-bottom: 14px;
            border-radius: 4px;
            font-size: 0.85em;
            color: #664d03;
        }

        .full-width { grid-column: 1 / -1; }

        .tabs {
            display: flex;
            gap: 6px;
            margin-bottom: 14px;
        }
        .tab-btn {
            flex: 1;
            padding: 8px;
            background: #eef4fa;
            color: #2c5f8a;
            border-radius: 4px;
            width: auto;
            margin: 0;
            font-size: 0.8em;
        }
        .tab-btn.active { background: #2c5f8a; color: white; }
    </style>
</head>
<body>
    <div class="container">
        <h1>🔐 GEFORP API — Admin Testing Interface</h1>
        <p class="subtitle">Gestion des API Keys et consultation des logs d'audit (ROLE_API_ADMIN requis)</p>

        <div class="session-bar">
            <div>
                Session: <span class="badge off" id="sessionBadge">Non connecté</span>
            </div>
            <div id="sessionUser">Aucun utilisateur</div>
            <div id="sessionOrg">Organisation: —</div>
            <div id="tokenExpiry">Expire: —</div>
        </div>

        <div class="grid">
            <!-- LOGIN -->
            <div class="card">
                <h2>Login <span class="method-badge post">POST</span></h2>
                <div class="info-box">
                    Connecte-toi avec un compte disposant du rôle <code>ROLE_API_ADMIN</code>.
                </div>

                <div class="form-group">
                    <label>Email:</label>
                    <input type="email" id="loginEmail" value="alice@org1.com">
                </div>
                <div class="form-group">
                    <label>Password:</label>
                    <input type="password" id="loginPassword" value="alice123">
                </div>
                <button onclick="login()">🔓 Se connecter</button>
                <button class="secondary" onclick="logout()">🚪 Effacer la session</button>
                <div id="loginResponse" class="response-box" style="display:none;"></div>
            </div>

            <!-- API KEYS ADMIN -->
            <div class="card full-width">
                <h2>Admin — API Keys <span class="method-badge post">POST</span> <span class="method-badge get">GET</span></h2>
                <div class="warn-box">
                    ⚠️ Nécessite le rôle ROLE_API_ADMIN sur le compte connecté.
                </div>

                <div class="tabs">
                    <button class="tab-btn active" onclick="setApiKeyTab(0)">📋 Lister</button>
                    <button class="tab-btn" onclick="setApiKeyTab(1)">➕ Créer</button>
                </div>

                <div class="form-group" id="createApiKeyForm" style="display:none;">
                    <label>Nom de la clé:</label>
                    <input type="text" id="newApiKeyName" placeholder="Intégration partenaire X" value="Integration Test">
                    <label style="margin-top:10px;">Permissions (séparées par virgules):</label>
                    <input type="text" id="newApiKeyPermissions" placeholder="trainings:read,trainings:write" value="trainings:read">
                    <button onclick="createApiKey()" style="margin-top:10px;">Créer la clé</button>
                </div>

                <div id="listApiKeysSection">
                    <button onclick="listApiKeys()">📋 Lister les clés</button>
                </div>

                <div class="warn-box" id="newKeyWarning" style="display:none;">
                    🔑 Cette clé ne sera plus jamais affichée en clair — copie-la maintenant.
                </div>

                <div id="apiKeysResponse" class="response-box" style="display:none;"></div>

                <div class="form-group" style="margin-top:16px;">
                    <label>Actions sur une clé (ID):</label>
                    <input type="text" id="apiKeyActionId" placeholder="1" value="1">
                    <div class="quick-buttons" style="margin-top:8px;">
                        <button class="secondary" onclick="rotateApiKey()">🔄 Rotate</button>
                        <button class="danger" onclick="revokeApiKey()">🚫 Revoke</button>
                    </div>
                </div>
            </div>

            <!-- AUDIT LOGS -->
            <div class="card full-width">
                <h2>Admin — Audit Logs <span class="method-badge get">GET</span></h2>
                <div class="info-box">
                    Chaque action sur une clé API (création, rotation, révocation, modification) génère automatiquement une entrée ici.
                </div>

                <button onclick="listAuditLogs()">📜 Voir les logs d'audit</button>

                <div id="auditLogsResponse" class="response-box" style="display:none;"></div>
            </div>
        </div>
    </div>

    <script>
        let session = { accessToken: null, refreshToken: null, email: null, orgId: null, expiresAt: null };
        const baseUrl = window.location.origin;

        function updateSessionBar() {
            const badge = document.getElementById('sessionBadge');
            if (session.accessToken) {
                badge.textContent = 'Connecté';
                badge.className = 'badge';
                document.getElementById('sessionUser').textContent = session.email || '—';
                document.getElementById('sessionOrg').textContent = 'Organisation: ' + (session.orgId || '—');
                document.getElementById('tokenExpiry').textContent = 'Expire: ' + (session.expiresAt || '—');
            } else {
                badge.textContent = 'Non connecté';
                badge.className = 'badge off';
                document.getElementById('sessionUser').textContent = 'Aucun utilisateur';
                document.getElementById('sessionOrg').textContent = 'Organisation: —';
                document.getElementById('tokenExpiry').textContent = 'Expire: —';
            }
        }

        function showResponse(id, data, ok=true) {
            const el = document.getElementById(id);
            el.textContent = typeof data === 'string' ? data : JSON.stringify(data, null, 2);
            el.className = `response-box ${ok ? 'success' : 'error'}`;
            el.style.display = 'block';
        }

        async function timedFetch(url, options) {
            return fetch(url, options);
        }

        function authHeaders(extra = {}) {
            const h = { ...extra };
            if (session.accessToken) h['Authorization'] = `Bearer ${session.accessToken}`;
            return h;
        }

        async function login() {
            const email = document.getElementById('loginEmail').value;
            const password = document.getElementById('loginPassword').value;

            try {
                const response = await timedFetch(`${baseUrl}/api/auth/login`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password })
                });
                const data = await response.json();

                if (response.ok) {
                    session.accessToken = data.access_token;
                    session.refreshToken = data.refresh_token;
                    session.email = data.user?.email;
                    session.orgId = data.user?.organization_id;
                    session.expiresAt = new Date(Date.now() + (data.expires_in || 900) * 1000).toLocaleTimeString();
                    updateSessionBar();
                }

                showResponse('loginResponse', data, response.ok);
            } catch (e) {
                showResponse('loginResponse', `Erreur: ${e.message}`, false);
            }
        }

        function logout() {
            session = { accessToken: null, refreshToken: null, email: null, orgId: null, expiresAt: null };
            updateSessionBar();
            showResponse('loginResponse', 'Session effacée localement', true);
        }

        function setApiKeyTab(index) {
            document.getElementById('createApiKeyForm').style.display = index === 1 ? 'block' : 'none';
            document.getElementById('listApiKeysSection').style.display = index === 0 ? 'block' : 'none';

            const tabs = document.querySelectorAll('.card:has(#createApiKeyForm) .tab-btn');
            tabs.forEach((btn, i) => btn.classList.toggle('active', i === index));
        }

        async function createApiKey() {
            if (!session.accessToken) {
                showResponse('apiKeysResponse', 'Connecte-toi d\'abord', false);
                return;
            }
            const name = document.getElementById('newApiKeyName').value;
            const permissions = document.getElementById('newApiKeyPermissions').value
                .split(',').map(p => p.trim()).filter(Boolean);

            try {
                const response = await timedFetch(`${baseUrl}/api/v1/admin/api-keys`, {
                    method: 'POST',
                    headers: authHeaders({ 'Content-Type': 'application/json' }),
                    body: JSON.stringify({ name, permissions })
                });
                const data = await response.json();

                document.getElementById('newKeyWarning').style.display = response.ok ? 'block' : 'none';
                showResponse('apiKeysResponse', data, response.ok);
            } catch (e) {
                showResponse('apiKeysResponse', `Erreur: ${e.message}`, false);
            }
        }

        async function listApiKeys() {
            if (!session.accessToken) {
                showResponse('apiKeysResponse', 'Connecte-toi d\'abord', false);
                return;
            }
            document.getElementById('newKeyWarning').style.display = 'none';
            try {
                const response = await timedFetch(`${baseUrl}/api/v1/admin/api-keys`, { headers: authHeaders() });
                const data = await response.json();
                showResponse('apiKeysResponse', data, response.ok);
            } catch (e) {
                showResponse('apiKeysResponse', `Erreur: ${e.message}`, false);
            }
        }

        async function rotateApiKey() {
            if (!session.accessToken) {
                showResponse('apiKeysResponse', 'Connecte-toi d\'abord', false);
                return;
            }
            const id = document.getElementById('apiKeyActionId').value;
            try {
                const response = await timedFetch(`${baseUrl}/api/v1/admin/api-keys/${id}/rotate`, {
                    method: 'POST',
                    headers: authHeaders()
                });
                const data = await response.json();
                document.getElementById('newKeyWarning').style.display = response.ok ? 'block' : 'none';
                showResponse('apiKeysResponse', data, response.ok);
            } catch (e) {
                showResponse('apiKeysResponse', `Erreur: ${e.message}`, false);
            }
        }

        async function revokeApiKey() {
            if (!session.accessToken) {
                showResponse('apiKeysResponse', 'Connecte-toi d\'abord', false);
                return;
            }
            const id = document.getElementById('apiKeyActionId').value;
            try {
                const response = await timedFetch(`${baseUrl}/api/v1/admin/api-keys/${id}/revoke`, {
                    method: 'POST',
                    headers: authHeaders()
                });
                const data = await response.json();
                showResponse('apiKeysResponse', data, response.ok);
            } catch (e) {
                showResponse('apiKeysResponse', `Erreur: ${e.message}`, false);
            }
        }

        async function listAuditLogs() {
            if (!session.accessToken) {
                showResponse('auditLogsResponse', 'Connecte-toi d\'abord', false);
                return;
            }
            try {
                const response = await timedFetch(`${baseUrl}/api/v1/admin/audit-logs`, { headers: authHeaders() });
                const data = await response.json();
                showResponse('auditLogsResponse', data, response.ok);
            } catch (e) {
                showResponse('auditLogsResponse', `Erreur: ${e.message}`, false);
            }
        }

        updateSessionBar();
    </script>
</body>
</html>
